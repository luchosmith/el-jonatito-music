{
  "name": "el-jonatito-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A standalone music player, extracted from El Jonatito's 🎧 Music.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "node scripts/build-web.mjs --watch",
    "start": "npm run build:web && tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "music:import": "tsx server/music-import.ts",
    "music:normalize": "tsx server/music-normalize.ts",
    "music:from-jonatito": "tsx server/jonatito-import.ts",
    "library:scan": "tsx server/library-scan.ts",
    "library:loudness": "tsx server/library-loudness.ts",
    "library:genres": "tsx server/library-genres.ts",
    "library:versions": "tsx server/library-versions.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test test/*.test.ts",
    "e2e:server": "node scripts/build-web.mjs && tsx server/index.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
